(svg
 (@width 100)
 (@height 100)
 (@xmlns http://www.w3.org/2000/svg)
 (($)
  ;; background
  (rect
   (@x 0) (@y 0) (@width 100) (@height 100) (@fill #1b0b2a)
  )

  ;; pumpkin
  (circle
   (@cx 50) (@cy 50) (@r 45) (@fill #d35400) (@stroke #5c2d00) (@stroke-width 3)
  )

  ;; stem
  (rect
   (@x 45) (@y 0) (@width 10) (@height 22) (@fill #6b3f1e) (@transform "rotate(-15 50 10)")
  )

  ;; left eye
  (polygon
   (@points "" 25,30 45,45 25,45)
   (@fill black)
  )

  ;; right eye
  (polygon
   (@points "" 75,30 55,45 75,45)
   (@fill black)
  )

  ;; nose
  (polygon
   (@points "" 50,50 45,60 55,60)
   (@fill black)
  )

  ;; mouth
  (path
   (@d "" M 25 70 L 35 80 L 45 70 L 55 80 L 65 70 L 75 80 L 75 75 L 25 75 Z)
   (@fill black)
  )
 )
)
